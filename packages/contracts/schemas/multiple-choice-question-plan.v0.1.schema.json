{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moodle-agent-poc:schema:planning:multiple-choice-question-plan:0.1",
  "title": "MultipleChoiceQuestionPlan v0.1",
  "$comment": "Frozen Planning Contracts v0.1 component. Choice-reference membership and uniqueness are domain invariants.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "pattern": "^choice-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "text": { "type": "string", "minLength": 1, "pattern": "\\S" }
      },
      "required": ["ref", "text"]
    }
  },
  "properties": {
    "ref": { "type": "string", "pattern": "^question-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "type": { "const": "multichoice" },
    "question": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "choices": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/choice" } },
    "correct_choice_refs": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^choice-[a-z0-9]+(?:-[a-z0-9]+)*$" } },
    "feedback": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "default_mark": { "type": "number", "exclusiveMinimum": 0 },
    "source_refs": { "type": "array", "items": { "$ref": "urn:moodle-agent-poc:schema:planning:source-reference:0.1" } }
  },
  "required": ["ref", "type", "question", "choices", "correct_choice_refs", "feedback", "default_mark", "source_refs"]
}
