{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moodle-agent-poc:schema:planning:essay-question-plan:0.1",
  "title": "EssayQuestionPlan v0.1",
  "$comment": "Frozen Planning Contracts v0.1 component. Essay grading remains manual.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ref": { "type": "string", "pattern": "^question-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "type": { "const": "essay" },
    "question": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "grading_guidance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
    "default_mark": { "type": "number", "exclusiveMinimum": 0 },
    "source_refs": { "type": "array", "items": { "$ref": "urn:moodle-agent-poc:schema:planning:source-reference:0.1" } }
  },
  "required": ["ref", "type", "question", "grading_guidance", "default_mark", "source_refs"]
}
