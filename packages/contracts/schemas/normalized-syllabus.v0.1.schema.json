{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moodle-agent-poc.local/schemas/normalized-syllabus.v0.1.schema.json",
  "title": "NormalizedSyllabus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "learning_objectives",
    "schedule_or_topics",
    "raw_text",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "course_title": {
      "type": "string",
      "minLength": 1
    },
    "course_code": {
      "type": "string",
      "minLength": 1
    },
    "course_description": {
      "type": "string"
    },
    "learning_objectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schedule_or_topics": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "topics"],
        "properties": {
          "week_or_unit": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "object",
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "start_line"],
                "properties": {
                  "kind": { "const": "line" },
                  "start_line": { "type": "integer", "minimum": 1 },
                  "end_line": { "type": "integer", "minimum": 1 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "paragraph_index"],
                "properties": {
                  "kind": { "const": "paragraph" },
                  "paragraph_index": { "type": "integer", "minimum": 1 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "page"],
                "properties": {
                  "kind": { "const": "page" },
                  "page": { "type": "integer", "minimum": 1 }
                }
              }
            ]
          }
        }
      }
    },
    "assessment_text": {
      "type": "string"
    },
    "raw_text": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "media_type", "byte_size", "sha256"],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
