{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moodle-agent-poc:schema:planning:assignment-plan:0.1",
  "title": "AssignmentPlan v0.1",
  "$comment": "Frozen Planning Contracts v0.1 component; declarative educational fields only.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ref": { "type": "string", "pattern": "^assignment-[a-z0-9]+(?:-[a-z0-9]+)*$", "description": "Plan-local assignment reference." },
    "type": { "const": "assignment" },
    "title": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "description": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "instructions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
    "learning_objectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
    "grade": { "type": "number", "exclusiveMinimum": 0, "description": "Positive maximum grade expressed as educational intent." },
    "source_refs": { "type": "array", "items": { "$ref": "urn:moodle-agent-poc:schema:planning:source-reference:0.1" } }
  },
  "required": ["ref", "type", "title", "description", "instructions", "learning_objectives", "grade", "source_refs"]
}
