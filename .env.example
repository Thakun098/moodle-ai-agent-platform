COMPOSE_PROJECT_NAME=moodle-agent-poc
POSTGRES_DB=moodle_agent_poc
POSTGRES_USER=moodle_agent_poc
POSTGRES_PASSWORD=moodle_agent_poc_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://moodle_agent_poc:moodle_agent_poc_dev@localhost:5432/moodle_agent_poc
LOG_LEVEL=debug

# Model provider: ollama | groq | unsloth
MODEL_PROVIDER=ollama

# Ollama
OLLAMA_MODEL=gemma4:e2b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Groq (used when MODEL_PROVIDER=groq)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=

# Unsloth / OpenAI-compatible LAN server (used when MODEL_PROVIDER=unsloth)
UNSLOTH_MODEL=
UNSLOTH_BASE_URL=http://192.168.1.50:8000/v1
UNSLOTH_API_KEY=

MOODLE_BASE_URL=http://localhost:8000
MOODLE_TOKEN=
MOODLE_TIMEOUT_MS=30000
MCP_SERVER_COMMAND=node
MCP_SERVER_ARGS=["C:/moodle-prac/ai-platform/apps/moodle-mcp-server/dist/index.js"]

AGENT_MODEL_TIMEOUT_MS=360000
MAX_MATERIAL_FILE_BYTES=31457280
ACTIVITY_CONTEXT_TOKEN_BUDGET=16000

# Moodle server-side Risk BFF shared credential (never expose to browser)
RISK_SERVICE_KEY=

# Dedicated server-side key for protected instructional-design BFF routes
INSTRUCTIONAL_DESIGN_SERVICE_KEY=

MOODLE_COMPETENCY_FRAMEWORK_ID=
