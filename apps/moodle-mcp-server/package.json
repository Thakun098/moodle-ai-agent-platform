{
  "name": "@moodle-agent-poc/moodle-mcp-server",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "default": "./dist/schemas/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run test/tool-schemas.test.ts test/mcp-server.test.ts test/mcp-stdio.test.ts",
    "test:integration": "vitest run test/mcp-server.integration.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@moodle-agent-poc/contracts": "workspace:*",
    "@moodle-agent-poc/moodle-client": "workspace:*",
    "ajv": "8.20.0",
    "zod": "4.5.4"
  }
}
