<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/agentpoc/db" VERSION="2026090400" COMMENT="XMLDB file for local_agentpoc"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
    <TABLES>
        <TABLE NAME="local_agentpoc_material" COMMENT="Teacher-managed material files and immutable snapshot rows">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
                <FIELD NAME="runid" TYPE="char" LENGTH="64" NOTNULL="true" />
                <FIELD NAME="structure_revision" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" />
                <FIELD NAME="sectionref" TYPE="char" LENGTH="128" NOTNULL="true" />
                <FIELD NAME="revision" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" />
                <FIELD NAME="usegrounding" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" />
                <FIELD NAME="publishcourse" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" />
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" />
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" />
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" />
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id" />
            </KEYS>
            <INDEXES>
                <INDEX NAME="run_section_revision" UNIQUE="false" FIELDS="runid, sectionref, revision" />
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>
