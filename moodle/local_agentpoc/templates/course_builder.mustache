{{!
    @template local_agentpoc/course_builder

    Course Builder UI Template.
}}
<div id="ai-course-builder-root" class="ai-course-builder-container" data-sesskey="{{sesskey}}" data-ajaxurl="{{ajaxurl}}">
    {{^has_categories}}
        <div class="alert alert-warning my-4">
            <h4 class="alert-heading">{{#str}} warning, core {{/str}}</h4>
            <p>{{#str}} errornocategorypermission, local_agentpoc {{/str}}</p>
        </div>
    {{/has_categories}}

    {{#has_categories}}
    <!-- Stepper Navigation -->
    <div class="stepper-wrapper mb-4">
        <div class="stepper-item step-item-1 active"><div class="step-counter">1</div><div class="step-name">Create Course Structure</div></div>
        <div class="stepper-line line-1-2"></div>
        <div class="stepper-item step-item-2"><div class="step-counter">2</div><div class="step-name">Course Structure</div></div>
        <div class="stepper-line line-2-3"></div>
        <div class="stepper-item step-item-3"><div class="step-counter">3</div><div class="step-name">Activity Structure</div></div>
        <div class="stepper-line line-3-4"></div>
        <div class="stepper-item step-item-4"><div class="step-counter">4</div><div class="step-name">Approve</div></div>
    </div>

    <!-- Error Banner Container -->
    <div id="builder-error-alert" class="alert alert-danger d-none my-3" role="alert">
        <div class="d-flex align-items-center">
            <i class="fa fa-exclamation-triangle fa-2x mr-3 text-danger" aria-hidden="true"></i>
            <div>
                <h5 class="alert-heading mb-1">{{#str}} error {{/str}}</h5>
                <p id="builder-error-message" class="mb-0"></p>
            </div>
        </div>
        <div id="builder-error-details" class="mt-2 text-muted small d-none">
            <pre class="bg-light p-2 rounded text-dark" style="max-height: 150px; overflow-y: auto;"></pre>
        </div>
        <div class="mt-2 text-right">
            <button type="button" class="btn btn-sm btn-outline-danger" id="btn-error-retry">
                {{#str}} errortryagain, local_agentpoc {{/str}}
            </button>
        </div>
    </div>

    <!-- VIEW 1: Upload Syllabus -->
    <div id="step-view-upload" class="step-view card shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="form-group mb-4">
                <label for="course-format-select" class="font-weight-bold">
                    Moodle Course Format <span class="text-danger">*</span>
                </label>
                <select id="course-format-select" class="custom-select form-control" required>
                    <option value="" selected disabled>Select a course format</option>
                    {{#formats}}
                        <option value="{{value}}">{{name}} ({{value}})</option>
                    {{/formats}}
                </select>
                <small class="form-text text-muted">This teacher-selected format is pinned to the Run and used at execution.</small>
            </div>

            <div class="form-group mb-4">
                <label for="course-category-select" class="font-weight-bold">
                    {{#str}} coursecategory, local_agentpoc {{/str}} <span class="text-danger">*</span>
                </label>
                <select id="course-category-select" class="custom-select form-control">
                    {{#categories}}
                        <option value="{{id}}">{{name}}</option>
                    {{/categories}}
                </select>
            </div>

            <div class="form-group mb-4">
                <label class="font-weight-bold">
                    {{#str}} syllabusfile, local_agentpoc {{/str}} <span class="text-danger">*</span>
                </label>
                <div id="syllabus-dropzone" class="border rounded p-4 text-center bg-light dropzone-area" style="cursor: pointer; border-style: dashed !important; border-width: 2px !important;">
                    <i class="fa fa-cloud-upload fa-3x text-primary mb-2" aria-hidden="true"></i>
                    <p class="mb-1 text-muted">{{#str}} syllabusfile_drop, local_agentpoc {{/str}}</p>
                    <p class="mb-2 text-muted small">or</p>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="btn-choose-file">
                        {{#str}} choosefile, local_agentpoc {{/str}}
                    </button>
                    <input type="file" id="syllabus-file-input" class="d-none" accept=".txt,.md,.markdown,.docx,.pdf">
                    <div id="selected-file-info" class="mt-2 d-none">
                        <span class="badge badge-success p-2">
                            <i class="fa fa-file-text-o mr-1"></i> <span id="selected-file-name"></span>
                        </span>
                    </div>
                </div>
            </div>

            <div class="form-group mb-4">
                <label for="optional-notes" class="font-weight-bold text-muted">
                    {{#str}} optionalnotes, local_agentpoc {{/str}}
                </label>
                <textarea id="optional-notes" class="form-control" rows="3" placeholder="{{#str}} optionalnotes_placeholder, local_agentpoc {{/str}}"></textarea>
                <small class="form-text text-muted">{{#str}} optionalnotes_hint, local_agentpoc {{/str}}</small>
            </div>

            <!-- Ingestion Progress Area (shown while generating) -->
            <div id="upload-progress-area" class="alert alert-info d-none mb-4">
                <div class="d-flex align-items-center mb-2">
                    <div class="spinner-border spinner-border-sm text-primary mr-2" role="status"></div>
                    <strong id="upload-progress-status">Uploading syllabus...</strong>
                </div>
                <div class="small text-muted" id="upload-progress-checklist">
                    <div><i class="fa fa-circle-o text-muted mr-1"></i> Processing syllabus file</div>
                    <div><i class="fa fa-circle-o text-muted mr-1"></i> Designing course structure with AI</div>
                    <div><i class="fa fa-circle-o text-muted mr-1"></i> Preparing plan preview</div>
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <a href="{{mycoursesurl}}" class="btn btn-outline-secondary mr-2" id="btn-cancel-upload">
                    {{#str}} cancel, local_agentpoc {{/str}}
                </a>
                <button type="button" class="btn btn-primary" id="btn-generate-plan" disabled>
                    <i class="fa fa-magic mr-1"></i> {{#str}} generateplan, local_agentpoc {{/str}}
                </button>
            </div>
        </div>
    </div>

    <!-- VIEW 2: Review Plan -->
    <div id="step-view-review" class="step-view d-none">
        <div class="row">
            <!-- Left Column: Course Structure Preview -->
            <div class="col-lg-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                        <h5 class="mb-0 font-weight-bold">{{#str}} generatedcourseplanpreview, local_agentpoc {{/str}}</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="course-title-section mb-4 pb-3 border-bottom">
                            <label class="text-muted small text-uppercase font-weight-bold mb-1">Course Title</label>
                            <div class="d-flex align-items-center justify-content-between">
                                <h4 id="preview-course-title" class="mb-0 text-primary font-weight-bold"></h4>
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-edit-course-title">
                                    <i class="fa fa-pencil mr-1"></i> {{#str}} edittitle, local_agentpoc {{/str}}
                                </button>
                            </div>
                            <p id="preview-course-summary" class="text-muted mt-2 mb-0 small"></p>
                        </div>

                        <!-- Sections Accordion Container -->
                        <div id="preview-sections-container">
                            <!-- Injected by JavaScript -->
                        </div>

                        <div class="mt-3">
                            <button type="button" class="btn btn-outline-primary btn-sm" id="btn-add-section">
                                <i class="fa fa-plus mr-1"></i> {{#str}} addsection, local_agentpoc {{/str}}
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Warnings & Assumptions -->
            <div class="col-lg-4">
                <div class="card shadow-sm mb-4 border-left-warning">
                    <div class="card-header bg-white py-3">
                        <h6 class="mb-0 font-weight-bold text-dark">
                            <i class="fa fa-info-circle text-warning mr-1"></i> {{#str}} warningassumptions, local_agentpoc {{/str}}
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <ul id="preview-warnings-list" class="list-unstyled mb-0 small text-muted">
                            <!-- Populated dynamically -->
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Review Actions Footer -->
        <div class="card shadow-sm mb-4">
            <div class="card-body d-flex justify-content-between align-items-center py-3">
                <button type="button" class="btn btn-outline-secondary" id="btn-review-back">
                    <i class="fa fa-arrow-left mr-1"></i> Back
                </button>
                <div>
                    <button type="button" class="btn btn-outline-info mr-2" id="btn-review-regenerate">
                        <i class="fa fa-refresh mr-1"></i> {{#str}} regenerate, local_agentpoc {{/str}}
                    </button>
                    <button type="button" class="btn btn-primary" id="btn-review-continue">
                        {{#str}} continuetoapproval, local_agentpoc {{/str}} <i class="fa fa-arrow-right ml-1"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- VIEW 3: Activity Structure -->
    <div id="step-view-activities" class="step-view d-none">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1 font-weight-bold">Activity Structure</h5>
                        <div class="small text-muted">Configure Quiz and Assignment independently for each week. Learning Material is optional and shared by both activities in the same week.</div>
                    </div>
                    <span class="badge badge-light border mt-2 mt-md-0">Step 3 of 4</span>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info py-2 mb-4">
                    <i class="fa fa-info-circle mr-1"></i>
                    Select Quiz, Assignment, both, or none for each week. If neither is selected, that week will be created as an empty course section.
                </div>

                <div class="activity-summary-strip border rounded bg-light p-3 mb-4">
                    <div class="row text-center">
                        <div class="col-4"><div class="small text-muted">Selected Activities</div><div id="activity-summary-selected" class="h5 mb-0 font-weight-bold">0</div></div>
                        <div class="col-4 border-left"><div class="small text-muted">Ready</div><div id="activity-summary-ready" class="h5 mb-0 font-weight-bold text-success">0</div></div>
                        <div class="col-4 border-left"><div class="small text-muted">Remaining</div><div id="activity-summary-remaining" class="h5 mb-0 font-weight-bold text-warning">0</div></div>
                    </div>
                </div>

                <div id="activity-structure-container"></div>
            </div>
        </div>
        <div class="card shadow-sm mb-4 activity-footer-card">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-center py-3">
                <button type="button" class="btn btn-outline-secondary mb-2 mb-md-0" id="btn-activity-back">
                    <i class="fa fa-arrow-left mr-1"></i> Back to Course Structure
                </button>
                <div class="d-flex flex-wrap align-items-center justify-content-end">
                    <div id="activity-footer-status" class="small text-muted mr-3 mb-2 mb-md-0">No activities selected.</div>
                    <button type="button" class="btn btn-primary" id="btn-activity-finalize">
                        Continue without Activities <i class="fa fa-arrow-right ml-1"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- VIEW 4: Approve -->
    <div id="step-view-approve" class="step-view d-none">
        <div class="row mb-4">
            <!-- Left Card: What will be created -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white py-3">
                        <h6 class="mb-0 font-weight-bold">{{#str}} whatwillbecreated, local_agentpoc {{/str}}</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex mb-3">
                            <div class="text-muted mr-3" style="width: 140px;">Course format</div>
                            <div class="font-weight-bold" id="approve-summary-format"></div>
                        </div>
                        <div class="d-flex mb-3">
                            <div class="text-muted mr-3" style="width: 140px;">Course title</div>
                            <div class="font-weight-bold" id="approve-summary-title"></div>
                        </div>
                        <div class="d-flex mb-3">
                            <div class="text-muted mr-3" style="width: 140px;">Course category</div>
                            <div class="font-weight-bold" id="approve-summary-category"></div>
                        </div>
                        <div class="d-flex mb-3">
                            <div class="text-muted mr-3" style="width: 140px;">Syllabus file</div>
                            <div class="font-weight-bold" id="approve-summary-filename"></div>
                        </div>
                        <div class="d-flex mb-3">
                            <div class="text-muted mr-3" style="width: 140px;">{{#str}} plannedsections, local_agentpoc {{/str}}</div>
                            <div class="font-weight-bold" id="approve-summary-sections"></div>
                        </div>
                        <div class="d-flex mb-3">
                            <div class="text-muted mr-3" style="width: 140px;">{{#str}} assignments, local_agentpoc {{/str}}</div>
                            <div class="font-weight-bold" id="approve-summary-assignments"></div>
                        </div>
                        <div class="d-flex mb-3">
                            <div class="text-muted mr-3" style="width: 140px;">{{#str}} quizzes, local_agentpoc {{/str}}</div>
                            <div class="font-weight-bold" id="approve-summary-quizzes"></div>
                        </div>
                        <div class="d-flex">
                            <div class="text-muted mr-3" style="width: 140px;">Empty sections</div>
                            <div class="font-weight-bold" id="approve-summary-empty-sections"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Card: Before you approve -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white py-3">
                        <h6 class="mb-0 font-weight-bold">{{#str}} beforeyouapprove, local_agentpoc {{/str}}</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3 text-success">
                            <i class="fa fa-check-circle fa-lg mr-2"></i>
                            <span class="text-dark font-weight-bold">{{#str}} coursewillbehidden, local_agentpoc {{/str}}</span>
                        </div>
                        <div class="d-flex align-items-center mb-3 text-success">
                            <i class="fa fa-check-circle fa-lg mr-2"></i>
                            <span class="text-dark font-weight-bold">{{#str}} youcaneditlater, local_agentpoc {{/str}}</span>
                        </div>
                        <div class="d-flex align-items-center text-success">
                            <i class="fa fa-check-circle fa-lg mr-2"></i>
                            <span class="text-dark font-weight-bold">{{#str}} nostudentswillsee, local_agentpoc {{/str}}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3"><h6 class="mb-0 font-weight-bold">Activity overview by week</h6></div>
            <div class="card-body p-3" id="approve-activity-overview"></div>
        </div>

        <div class="card shadow-sm mb-4" id="approve-official-preview-card">
            <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center">
                <h6 class="mb-0 font-weight-bold">Official Preview</h6>
                <span class="badge badge-light border" id="approve-preview-identity"></span>
            </div>
            <div class="card-body p-3" id="approve-official-preview">
                <!-- Injected from the finalized current CoursePlan revision. -->
            </div>
        </div>

        <div id="ai-review-ack-area" class="alert alert-warning d-none mb-4">
            <div class="font-weight-bold mb-2"><i class="fa fa-exclamation-triangle mr-1"></i> Teacher review required</div>
            <div class="small mb-2">One or more activities contain AI-expanded content based on syllabus scope rather than supplied Learning Material.</div>
            <div class="custom-control custom-checkbox">
                <input type="checkbox" class="custom-control-input" id="ack-ai-expanded-content">
                <label class="custom-control-label" for="ack-ai-expanded-content">I have reviewed the AI-expanded activity content.</label>
            </div>
        </div>

        <div class="alert alert-info py-3 mb-4 d-flex align-items-center">
            <i class="fa fa-info-circle fa-lg mr-2 text-info"></i>
            <div>{{#str}} draftcoursecreatednotice, local_agentpoc {{/str}}</div>
        </div>

        <!-- Approval Actions Footer -->
        <div class="card shadow-sm mb-4">
            <div class="card-body d-flex justify-content-between align-items-center py-3">
                <button type="button" class="btn btn-outline-secondary" id="btn-approve-back">
                    <i class="fa fa-arrow-left mr-1"></i> {{#str}} backtoreview, local_agentpoc {{/str}}
                </button>
                <button type="button" class="btn btn-primary btn-lg" id="btn-approve-execute">
                    <i class="fa fa-check-square-o mr-1"></i> {{#str}} approvecoursedraft, local_agentpoc {{/str}}
                </button>
            </div>
        </div>
    </div>

    <!-- VIEW 4: Executing Progress -->
    <div id="step-view-executing" class="step-view d-none">
        <div class="card shadow-sm mb-4">
            <div class="card-body p-5 text-center">
                <h4 class="mb-4 font-weight-bold">Creating course in Moodle...</h4>
                <div class="execution-progress-container text-left mx-auto" style="max-width: 400px;">
                    <div id="exec-step-approval" class="mb-2 text-muted">
                        <i class="fa fa-check-circle text-success mr-2"></i> {{#str}} approvalchecked, local_agentpoc {{/str}}
                    </div>
                    <div id="exec-step-validate" class="mb-2 text-muted">
                        <i class="fa fa-circle-o mr-2"></i> {{#str}} planvalidated, local_agentpoc {{/str}}
                    </div>
                    <div id="exec-step-create" class="mb-2 text-muted">
                        <i class="fa fa-circle-o mr-2"></i> {{#str}} creatingmoodlecourse, local_agentpoc {{/str}}
                    </div>
                    <div id="exec-step-verify" class="mb-2 text-muted">
                        <i class="fa fa-circle-o mr-2"></i> {{#str}} verifyingresult, local_agentpoc {{/str}}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- VIEW 5: Completed -->
    <div id="step-view-completed" class="step-view d-none">
        <div class="card shadow-sm mb-4 border-success">
            <div class="card-body p-5 text-center">
                <div class="text-success mb-3">
                    <i class="fa fa-check-circle fa-4x"></i>
                </div>
                <h3 class="font-weight-bold text-success mb-3">{{#str}} coursecreatedsuccessfully, local_agentpoc {{/str}}</h3>
                <p class="text-muted mb-4">Your course has been created and verified in Moodle.</p>

                <div class="card bg-light text-left mx-auto mb-4 p-3" style="max-width: 500px;">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Course Title:</span>
                        <strong id="success-course-title"></strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Sections:</span>
                        <strong id="success-sections-count"></strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Assignments:</span>
                        <strong id="success-assignments-count"></strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Quizzes:</span>
                        <strong id="success-quizzes-count"></strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Deterministic Verification:</span>
                        <strong class="text-success"><i class="fa fa-check"></i> Passed</strong>
                    </div>
                </div>

                <div class="d-flex justify-content-center">
                    <button type="button" class="btn btn-outline-secondary mr-3" id="btn-create-another">
                        {{#str}} createanothercourse, local_agentpoc {{/str}}
                    </button>
                    <a href="#" class="btn btn-primary btn-lg" id="btn-open-course">
                        <i class="fa fa-external-link mr-1"></i> {{#str}} opencourseinmoodle, local_agentpoc {{/str}}
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Title Modal -->
    <div class="modal fade" id="modal-edit-title" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold">Edit Course Title</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="input-edit-course-title" class="font-weight-bold">Course Title</label>
                        <input type="text" class="form-control" id="input-edit-course-title">
                    </div>
                    <div class="form-group">
                        <label for="input-edit-course-summary" class="font-weight-bold">Course Summary</label>
                        <textarea class="form-control" id="input-edit-course-summary" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="btn-save-course-title">Save changes</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Section Modal -->
    <div class="modal fade" id="modal-edit-section" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold">Edit Section</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="input-edit-section-index">
                    <div class="form-group">
                        <label for="input-edit-section-title" class="font-weight-bold">Section Title</label>
                        <input type="text" class="form-control" id="input-edit-section-title">
                    </div>
                    <div class="form-group">
                        <label for="input-edit-section-summary" class="font-weight-bold">Section Summary</label>
                        <textarea class="form-control" id="input-edit-section-summary" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="btn-save-section">Save changes</button>
                </div>
            </div>
        </div>
    </div>
    {{/has_categories}}
</div>

<style>
.stepper-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    padding: 10px 40px;
}
.stepper-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 2;
}
.step-counter {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #e9ecef;
    color: #6c757d;
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: bold;
    margin-bottom: 6px;
    border: 2px solid transparent;
}
.stepper-item.active .step-counter {
    background: #0f6cbf;
    color: #fff;
}
.stepper-item.completed .step-counter {
    background: #28a745;
    color: #fff;
}
.step-name {
    font-size: 0.9rem;
    font-weight: 500;
    color: #6c757d;
}
.stepper-item.active .step-name {
    color: #0f6cbf;
    font-weight: bold;
}
